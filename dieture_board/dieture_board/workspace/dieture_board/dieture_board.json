 "content": "[{\"id\": \"h1\", \"type\": \"header\", \"data\": {\"text\": \"<span class='h4'><b>Dieture Board</b></span>\", \"col\": 12}}, {\"id\": \"p1\", \"type\": \"paragraph\", \"data\": {\"text\": \"Three scores; seven ranked bets, each written backwards from THEN WHAT to WHAT. Every bet starts with a tiny test of its SO WHAT; every piece of work is a promise with a name, a date and an agreed definition of done. The system turns things RED by itself. Thursday: owners update. Sunday: Chief of Staff reviews RED rows.\", \"col\": 12}}, {\"id\": \"s1\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"The Board\", \"col\": 4}}, {\"id\": \"s2\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"My promises\", \"col\": 4}}, {\"id\": \"s3\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"New Bet\", \"col\": 4}}, {\"id\": \"c1\", \"type\": \"card\", \"data\": {\"card_name\": \"Everyone\", \"col\": 4}}, {\"id\": \"c2\", \"type\": \"card\", \"data\": {\"card_name\": \"Chief of Staff and bet owners\", \"col\": 4}}, {\"id\": \"c3\", \"type\": \"card\", \"data\": {\"card_name\": \"Managers only\", \"col\": 4}}]",
